{
  "name": "earshot-voice",
  "main": "src/index.js",
  "compatibility_date": "2026-10-23",
  "vars": {
    // Comma-separated. Only pages from these origins can join a room.
    "ALLOWED_ORIGINS": "http://localhost:4710",
    "MAX_PLAYERS": "8",
    "TURN_TTL_SECONDS": "14400"
  },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "VoiceRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VoiceRoom"] }]
}
